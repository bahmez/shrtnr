# Database Configuration
# For Docker: Use PostgreSQL
DATABASE_URL=postgresql://shrtnr:shrtnr_password@localhost:5432/shrtnr
# For local dev: Use SQLite
# DATABASE_URL=sqlite:shrtnr.db?mode=rwc

# JWT Secret (REQUIRED in production!)
# Generate a secure random string: openssl rand -base64 32
JWT_SECRET=change-this-secret-in-production-use-a-long-random-string

# Leptos Configuration (optional, defaults in Cargo.toml)
# LEPTOS_SITE_ADDR=127.0.0.1:3000
# LEPTOS_SITE_ROOT=site
